DATABASE_URL=
AUTH_TOKEN_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_AUTH_SECRET=
ADMIN_TELEGRAM_ID=

APP_BASE_URL=https://tudominio.com
NEXT_PUBLIC_APP_URL=https://tudominio.com

OPENROUTER_API_KEY=
OPENROUTER_CHAT_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=anthropic/claude-haiku-4-5
# Helicone (opcional) — observabilidad LLM. Si está configurada, las llamadas
# del chat principal pasan por el proxy de Helicone y aparecen en su dashboard
# (cost por user, latencia, prompt inspection). Si no, se llama directo a
# OpenRouter sin diferencia funcional.
HELICONE_API_KEY=

# Telegram Bot
TELEGRAM_BOT_TOKEN=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=

# Email transaccional (Resend)
RESEND_API_KEY=
EMAIL_FROM=TresMilMillonesdeLatidos <info@tresmilmillonesdelatidos.es>

# Google OAuth — "Registrarse con Google"
# Crear credencial en https://console.cloud.google.com/apis/credentials
# Authorized redirect URI debe coincidir EXACTAMENTE con GOOGLE_REDIRECT_URI
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://tudominio.com/api/auth/google/callback

# Cron jobs — generar con: openssl rand -hex 32
CRON_SECRET=

# Builder.io (CMS)
NEXT_PUBLIC_BUILDER_API_KEY=

# Sentry — error monitoring, tracing, session replay
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Google Analytics 4 — measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta (Facebook) Pixel — pixel ID (e.g. 1234567890)
NEXT_PUBLIC_META_PIXEL_ID=

# Better Stack — structured log ingestion
LOGTAIL_SOURCE_TOKEN=

# Telegram — additional settings
TELEGRAM_WEBHOOK_SECRET=        # Secret to verify incoming Telegram webhook requests
TELEGRAM_BOT_USERNAME=          # Bot username without @ (e.g. mi_bot)
TELEGRAM_CHAT_ID=               # Default chat/group ID for admin notifications

# n8n — automation webhooks
N8N_TRANSITIONAL_VOID_WEBHOOK=  # n8n webhook URL for transitional void flow
N8N_ACTION_WEBHOOK=             # n8n webhook URL for action-based automations
N8N_EVENTS_WEBHOOK_URL=         # n8n webhook URL for event dispatching (signup, checkin, crisis, etc.)

# Feature flags
FREE_PLAN_UNLIMITED=false       # Set to "true" to remove message limits on free plan
MVP_PRO_UNTIL=2026-10-08        # Pro gratis para todos hasta esta fecha (YYYY-MM-DD). Borrar para desactivar.

# Crisis system
CRISIS_ACTIVE_HOURS=6           # Number of hours the "crisis" flag stays active on UserState after being triggered (1-72, default 6). Parsed as a single integer.

# Email provider (generic — alternative to Resend)
EMAIL_PROVIDER=resend           # Email service: resend | sendgrid | ses
EMAIL_API_KEY=                  # API key for the chosen email provider
ALERT_EMAIL=                    # Destination email for system alerts and critical notifications

# HeyGen — avatar video generation
HEYGEN_API_KEY=                 # API key from https://app.heygen.com/settings
HEYGEN_VOICE_ID=                # Voice ID for avatar videos (e.g. Spanish male/female)

# Web Push (VAPID keys) — generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# LLM provider (Anthropic) — usado por /api/telegram/webhook y otros handlers
ANTHROPIC_API_KEY=              # sk-ant-... Obligatorio en prod para el mentor conversacional.

# Auth / sesión — usado como fallback y para firmar magic links de Telegram
SESSION_SECRET=                 # Cadena aleatoria larga (>=32 chars). Sin ella, telegram-link usa clave insegura de dev.

# Prisma connection pool
DATABASE_POOL_MAX=50            # Tamaño máx. del pool (default 50). Bajar si el Postgres tiene límites estrictos.

# Logging
SYSTEM_LOG_DB=1                 # "1" escribe logs a BD (default), "0" solo stdout. Útil para desactivar en tests.

# Telegram — bot ADMIN (alertas internas). Si falta, cae en TELEGRAM_BOT_TOKEN.
TELEGRAM_BOT_TOKEN_ADMIN=       # Token del bot dedicado a alertas admin (separado del bot de usuarios).

# Alertas email (visible en UI admin)
NEXT_PUBLIC_ALERT_EMAIL=        # Email mostrado al admin como destino de notificaciones críticas.

# HuggingFace Inference API — capa NLP de detección de emociones (opcional).
# Sin token, el sistema usa solo el detector por keywords (emotional-model.ts).
# Crear token de lectura en https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=          # hf_... — opcional; activa pysentimiento/robertuito-emotion-analysis
