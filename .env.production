# ============================================
# PRODUCTION ENVIRONMENT VARIABLES
# ============================================
# Copy this to your Coolify deployment and fill in values

# Node environment
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Port (Coolify manages this, but keeping explicit)
PORT=3000

# ============================================
# EXTERNAL APIS
# ============================================
# OpenRouter API Key - REQUIRED
# Get from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-XXXXXXXXXXXXXXXXXXXX

# ============================================
# DATABASE (Optional - not used in MVP)
# ============================================
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
# DATABASE_URL=postgresql://user:password@db.example.com:5432/mentor_web

# ============================================
# STRIPE BILLING
# ============================================
# Stripe secret key (use live key in production: sk_live_...)
STRIPE_SECRET_KEY=sk_live_XXXXXXXXXXXXXXXXXXXX
# Stripe publishable key (use live key in production: pk_live_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_XXXXXXXXXXXXXXXXXXXX
# Webhook secret from Stripe Dashboard > Webhooks
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXX
# Price IDs from Stripe Dashboard > Products
STRIPE_PRICE_PRO_MONTHLY=price_XXXXXXXXXXXXXXXXXXXX
STRIPE_PRICE_PRO_ANNUAL=price_XXXXXXXXXXXXXXXXXXXX

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info

# ============================================
# MONITORING (Optional)
# ============================================
# Sentry error tracking
# SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# ============================================
# SECURITY
# ============================================
# CORS origins (comma-separated)
# ALLOWED_ORIGINS=https://mentor.example.com,https://app.mentor.example.com

# Rate limiting (requests per minute)
RATE_LIMIT_REQUESTS=100

# App base URL — used for Stripe redirect URLs
NEXT_PUBLIC_APP_URL=https://luciernaga.ai
