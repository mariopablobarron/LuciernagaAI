{
  "name": "mentor-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "npx prisma migrate deploy && next start",
    "lint": "eslint",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "system-check": "bash scripts/system-check.sh",
    "hardening:auto": "node scripts/auto-update-hardening-board.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tg-tasks": "node scripts/tg-tasks.mjs",
    "agent": "bash scripts/testing-agent.sh",
    "agent:run": "bash scripts/testing-agent.sh run",
    "agent:watch": "bash scripts/testing-agent.sh watch",
    "agent:health": "bash scripts/testing-agent.sh health",
    "agent:monitor": "bash scripts/testing-agent.sh monitor",
    "agent:ci": "bash scripts/testing-agent.sh ci",
    "agent:audit": "bash scripts/testing-agent.sh audit",
    "agent:hooks": "bash scripts/testing-agent.sh hooks",
    "test:email": "node scripts/test-email.mjs",
    "test:telegram": "node scripts/test-telegram-send.mjs",
    "docs:commands:update": "node scripts/auto-update-commands-doc.mjs",
    "docs:commands:check": "node scripts/auto-update-commands-doc.mjs --check",
    "migrate:deploy": "prisma migrate deploy",
    "backup:daily": "bash scripts/db-backup-daily.sh",
    "backup:restore:latest": "gunzip -c ./backups/db/latest.sql.gz | psql \"$DATABASE_URL\"",
    "translate": "node scripts/translate.mjs"
  },
  "dependencies": {
    "@blocknote/mantine": "^0.47.3",
    "@blocknote/react": "^0.47.3",
    "@logtail/next": "^0.3.1",
