// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "darwin-arm64"]
}

datasource db {
  provider = "postgresql"
}

model Conversation {
  id             String    @id @default(cuid())
  userRefId      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  messages       Json      @default("[]")
  messageRecords Message[] @relation("ConversationMessages")
  user           User?     @relation("UserConversations", fields: [userRefId], references: [id], onDelete: SetNull)

  @@index([userRefId])
}

model User {
  id            String         @id @default(cuid())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  lastSeen      DateTime       @default(now())
  conversations Conversation[] @relation("UserConversations")
  messages      Message[]      @relation("UserMessages")
}

model Message {
  id                String        @id @default(cuid())
  conversationId    String
  userRefId         String?
  conversationRefId String?
  content           String
  createdAt         DateTime      @default(now())
  user              User?         @relation("UserMessages", fields: [userRefId], references: [id], onDelete: SetNull)
  conversation      Conversation? @relation("ConversationMessages", fields: [conversationRefId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([createdAt])
  @@index([userRefId])
  @@index([conversationRefId])
}

model DailyLog {
  id            String   @id @default(cuid())
  userId        String
  checkIns      Int      @default(0)
  messagesCount Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
}

model Insight {
  id        String   @id @default(cuid())
  type      String   // retention, behavior, risk, clarity, engagement
  title     String
  content   String
  action    String
  priority  String   @default("medium") // low, medium, high
  createdAt DateTime @default(now())
}

model UserState {
  id        String   @id @default(cuid())
  userId    String   @unique
  state     String   // "neutral" | "bloqueado" | "perdido" | "ansioso"
  updatedAt DateTime @updatedAt

  @@index([state, updatedAt])
}

model DailyCheckin {
  id        String   @id @default(cuid())
  userId    String
  response  String
  mood      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model DecisionLog {
  id        String   @id @default(cuid())
  metric    String
  value     Float
  decision  String
  createdAt DateTime @default(now())

  @@index([metric, createdAt])
}
