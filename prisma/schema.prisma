// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin-arm64"]
}

datasource db {
  provider = "postgresql"
}

enum SubscriptionStatus {
  active
  trialing
  past_due
  canceled
  incomplete
}

enum SubscriptionPlan {
  free
  pro
}

enum GoalStatus {
  active
  paused
  completed
  abandoned
}

enum InterventionStatus {
  sent
  read
  resolved
}

model Conversation {
  id             String    @id @default(cuid())
  userId         String?
  title          String    @default("Nueva conversación")
  rating         Int? // 1 = helpful, -1 = not helpful
  journalMode    Boolean   @default(false) // silent / no AI responses
  /// Progressive summary of older messages (LangChain SummaryBufferMemory pattern):
  /// when a conversation grows past ~20 messages, oldest are condensed into 2-3
  /// sentences captured here. The last K messages stay verbatim for immediacy.
  /// Lets the mentor remember decisions / names / arcs from turn 3 even at turn 50,
  /// without bloating the system prompt.
  summarySoFar             String?  @db.Text
  /// Highest message ID already covered by summarySoFar. Lets us re-summarize only
  /// the delta when new messages fall outside the verbatim window.
  summarizedUpToMessageId  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  messageRecords Message[] @relation("ConversationMessages")
  user           User?     @relation("UserConversations", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

/// Age range bucket. Stored as opaque string (project convention favours
/// String + comment over native enums). Valid values:
///   - "14_17"   adolescents
///   - "18_29"   young adults
///   - "30_49"   adults
///   - "50_69"   mid-late adults
///   - "70_plus" elders
/// Users declaring under_14 are blocked at the entry screen and never
/// reach this column (no row is created).
model User {
  id                        String                    @id @default(cuid())
  email                     String                    @unique
  name                      String?
  bio                       String?
  avatarData                String?
  role                      String                    @default("user")
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  lastSeen                  DateTime                  @default(now())
  passwordHash              String?
  telegramId                String?                   @unique
  googleId                  String?                   @unique
  stripeCustomerId          String?                   @unique
  consentGiven              Boolean                   @default(false)
  consentAt                 DateTime?
  /// Versión del texto de Términos+Privacidad aceptada por el usuario en el
  /// momento del registro. Nullable para users anteriores a esta columna.
  /// Cuando publiquemos un texto nuevo, comparamos contra CURRENT_CONSENT_VERSION
  /// y pedimos re-aceptar al usuario antes de seguir.
  consentVersion            String?
  /// Rango etario auto-declarado en onboarding. Ver comentario sobre el modelo
  /// User para los valores válidos. Nullable: usuarios anteriores a esta
  /// columna no lo tienen y se les pedirá la primera vez que vuelvan.
  ageRange                  String?
  /// Idioma preferido del usuario (es/en/pt/fr). Se captura en signup desde
  /// el contexto del request (cookie NEXT_LOCALE o body.locale del cliente).
  /// Usado por todos los emails programados (nudges, weekly letter, family
  /// invites...) que se envían fuera de un request context activo.
  /// Default "es" por compatibilidad con users históricos.
  locale                    String                    @default("es")
  source                    String?
  isActive                  Boolean                   @default(true)
  latidos                   Int                       @default(0)
  messageCount              Int                       @default(0)
  lastMessageAt             DateTime?
  conversations             Conversation[]            @relation("UserConversations")
  messages                  Message[]                 @relation("UserMessages")
  goals                     Goal[]
  crisisEvents              CrisisEvent[]
  avoidanceEvents           AvoidanceEvent[]
  subscriptions             Subscription[]
  userProfile               UserProfile?
  userChallenges            UserChallenge[]
  dailyLogs                 DailyLog[]
  futureMessages            FutureMessage[]
  capsules                  Capsule[]
  streak                    Streak?
  clinicalNotes             ClinicalNote[]
  assessments               Assessment[]
  wins                      Win[]
  actionReminders           ActionReminder[]
  circleMembers             CircleMember[]
  communityPosts            CommunityPost[]
  communityReports          CommunityReport[]
  pushSubscriptions         PushSubscription[]
  notifications             Notification[]
  heartbeats                Heartbeat[]
  commitments               DailyCommitment[]
  files                     UserFile[]
  questionsAsked            AnonQuestion[]            @relation("QuestionsAsked")
  questionsReceived         AnonQuestion[]            @relation("QuestionsReceived")
  anonAnswers               AnonAnswer[]
  anonAnswerVotes           AnonAnswerVote[]
  circlePulseResponses      CirclePulseResponse[]
  mentorReflections         MentorReflection[]
  circleClosingLetters      CircleClosingLetter[]
  preferences               UserPreferences?
  trustedContact            TrustedContact?
  supportMessages           SupportMessage[]
  familyPings               FamilyPing[]
  invitations               Invitation[]              @relation("InvitationsSent")
  invitationsReceived       Invitation[]              @relation("InvitationsReceived")
  invitesEarned             Int                       @default(0)
  tags                      String[]                  @default([]) // manual marketing tags (e.g. "beta", "vip", "churning")
  passwordResetTokens       PasswordResetToken[]
  userActions               UserAction[]
  interventions             Intervention[]            @relation("UserInterventions")
  userJourneys              UserJourney[]
  userExercises             UserExercise[]
  userState                 UserState?
  dailyCheckins             DailyCheckin[]
  llmLogs                   LlmLog[]
  feedbacks                 Feedback[]
  scheduledEmails           ScheduledEmail[]
  latidoTransactions        LatidoTransaction[]
  events                    Event[]
  personalProjects          PersonalProject[]
  diaryEntries              DiaryEntry[]
  userBadges                UserBadge[]
  goalAvatarVideos          GoalAvatarVideo[]
  broadcastAvatarDeliveries BroadcastAvatarDelivery[]
  usageSessions             UsageSession[]
  adminMessages             AdminMessage[]
  weeklyLetters             WeeklyLetter[]
  teamLetterRequests        TeamLetterRequest[]
  enneagramAssessments      EnneagramAssessment[]
  dailyRoundResponses       DailyRoundResponse[]
  dailyRoundReactions       DailyRoundReaction[]
  dailyRoundMirrors         DailyRoundMirror[]
  phone                     String?
  emailVerified             Boolean                   @default(false)
  emailVerifyToken          String?
  emailVerifyExpires        DateTime?
  deletedAt                 DateTime? // soft delete — null means active
  // Activation audit fields — populated on first message, aha moment and
  // onboarding wizard completion. Reads in /admin/analytics/activacion use
  // these instead of recomputing from Message + Action every time.
  firstMessageSentAt        DateTime?
  activatedAt               DateTime? // aha moment: ≥3 user messages in 72h + ≥1 action completada
  onboardingCompletedAt     DateTime?
  onboardingContext         Json? // { feeling, timeframe, intent } captured in /app/inicio; injected in first 5 mentor turns
  organizationId            String?
  organization              Organization?             @relation(fields: [organizationId], references: [id])
  classroomId               String?
  classroom                 Classroom?                @relation(fields: [classroomId], references: [id])

  @@index([organizationId])
  @@index([isActive, createdAt])
  @@index([lastSeen])
  @@index([createdAt])
  @@index([organizationId, isActive, lastSeen])
  @@index([classroomId])
  @@index([deletedAt])
  @@index([activatedAt])
  @@index([firstMessageSentAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  userId         String?
  role           String       @default("user") // "user" | "assistant"
  content        String
  createdAt      DateTime     @default(now())
  /// Embedding semántico (text-embedding-3-small, 1536 dims). Vacío hasta que
  /// el cron `/api/cron/embed-pending-messages` lo rellene. Sin pgvector:
  /// Float[] nativo + coseno calculado en aplicación.
  embedding      Float[]      @default([])
  embeddedAt     DateTime?
  user           User?        @relation("UserMessages", fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation("ConversationMessages", fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([createdAt])
  @@index([userId, createdAt])
}

// ── Goal avatar videos (HeyGen) ────────────────────────────────────────────
// Three milestone videos per goal: START (umbral), MIDPOINT (prueba — triggered
// by low emotional state while goal is active), END (retorno — on completion).
// Delivered once via modal on app open. See /api/cron/goal-avatar-midpoint.

model GoalAvatarVideo {
  id            String    @id @default(cuid())
  userId        String
  goalId        String
  phase         String // START | MIDPOINT | END
  trigger       String // goal_created | state_bloqueo | state_low_energy | goal_completed
  script        String    @db.Text
  heygenVideoId String?
  videoUrl      String?
  status        String    @default("PENDING") // PENDING | READY | FAILED
  errorMessage  String?
  seenAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal          Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, phase]) // exactly one video per phase per goal
  @@index([status])
  @@index([userId, seenAt])
}

// ── Broadcast avatar videos ────────────────────────────────────────────────
// Admin-initiated personalized videos from the marketing panel. One campaign
// row per "send" + one delivery row per recipient. When isShared=true the
// HeyGen video is generated once and the URL is copied to every delivery.

model BroadcastAvatarCampaign {
  id             String                    @id @default(cuid())
  title          String // admin-facing label
  segment        String // "all" | "single" | "active_7d" | ...
  mode           String // "literal" | "briefing"
  isShared       Boolean                   @default(false) // one video reused for all recipients
  briefing       String?                   @db.Text // briefing text if mode=briefing
  literalScript  String?                   @db.Text // explicit script if mode=literal
  sharedVideoUrl String? // filled when isShared && generation completed
  sharedHeygenId String?
  status         String                    @default("PENDING") // PENDING | GENERATING | READY | FAILED
  errorMessage   String?
  recipientCount Int                       @default(0)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  createdBy      String?
  deliveries     BroadcastAvatarDelivery[]

  @@index([createdAt])
  @@index([status])
}

model BroadcastAvatarDelivery {
  id            String                  @id @default(cuid())
  campaignId    String
  userId        String
  script        String                  @db.Text
  heygenVideoId String? // only for per-user videos; null for shared
  videoUrl      String? // final URL served to the user
  status        String                  @default("PENDING") // PENDING | READY | FAILED
  errorMessage  String?
  seenAt        DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign      BroadcastAvatarCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([userId, seenAt])
  @@index([status])
}

// Singleton row (id="singleton") edited from /admin/marketing.
model AvatarVideoConfig {
  id                        String   @id @default("singleton")
  enabled                   Boolean  @default(false) // global kill switch
  maxVideosPerDay           Int      @default(30) // hard cap per day to cap cost
  midpointMinDays           Int      @default(3) // wait at least N days after goal start
  // Broadcast guardrails — discipline-as-code so the marketing channel
  // doesn't degrade through overuse.
  maxBroadcastsPerMonth     Int      @default(4) // hard cap on broadcasts in any rolling 30-day window
  broadcastUserCooldownDays Int      @default(7) // skip recipients who got any broadcast in last N days
  welcomeCampaignId         String? // BroadcastAvatarCampaign.id used as welcome video for new signups
  tone                      String   @default("interpellation")
  avatarId                  String   @default("e2ff51edb1154b0dbe2c8f0df59818cf")
  promptTemplateStart       String   @db.Text
  promptTemplateMidpoint    String   @db.Text
  promptTemplateEnd         String   @db.Text
  updatedAt                 DateTime @updatedAt
  updatedBy                 String?
}

model DailyLog {
  id              String   @id @default(cuid())
  userId          String
  checkIns        Int      @default(0)
  messagesCount   Int      @default(0)
  logDate         DateTime @default(now())
  emotionalState  String?
  note            String?
  mood            String?
  challengeStatus String?
  momentum        Int?
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, logDate])
  @@index([emotionalState, createdAt])
  @@index([userId, emotionalState, createdAt])
}

model Insight {
  id         String   @id @default(cuid())
  type       String // retention, behavior, risk, clarity, engagement
  title      String
  content    String
  action     String
  confidence String   @default("medium") // low, medium, high
  priority   String   @default("medium") // low, medium, high
  createdAt  DateTime @default(now())
}

model UserState {
  id                  String    @id @default(cuid())
  userId              String    @unique
  state               String    @default("neutral")
  systemState         String    @default("ESTABLE") // SystemState — last computed behavioral state
  transformationPhase String    @default("bloqueo")
  mood                String?
  primaryEmotion      String    @default("calma")
  dominantPattern     String    @default("evita_decidir")
  focusArea           String    @default("propósito")
  energyLevel         String    @default("medio")
  riskLevel           String    @default("low")
  progressTrend       String    @default("igual")
  crisisActive        Boolean   @default(false)
  crisisActivatedAt   DateTime?
  crisisActiveUntil   DateTime?
  dialogueIntent      String    @default("clarification")
  dialogueStep        Int       @default(0)
  dialogueFlow        String? // active flow name or null
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([state, updatedAt])
  @@index([systemState, updatedAt])
  @@index([transformationPhase, updatedAt])
  @@index([primaryEmotion, dominantPattern, updatedAt])
  @@index([crisisActive, crisisActiveUntil])
}

model DailyCheckin {
  id        String   @id @default(cuid())
  userId    String
  response  String
  mood      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model DecisionLog {
  id        String   @id @default(cuid())
  metric    String
  value     Float
  decision  String
  createdAt DateTime @default(now())

  @@index([metric, createdAt])
}

model AdminSnapshot {
  id          String   @id @default(cuid())
  type        String // "reset" | "manual" | "scheduled"
  label       String? // Optional label (e.g. "Pre-reset 2026-04-07")
  data        Json // ⚠️ deprecated 2026-04-23: se escribe en /api/admin/export pero ningún consumidor lo lee. Conservado para no perder snapshots históricos.
  summary     String? // Human-readable summary of what was archived
  recordCount Int      @default(0) // Total records archived
  createdAt   DateTime @default(now())

  @@index([type, createdAt])
}

model Event {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  metadata  Json? // ⚠️ deprecated 2026-04-23: columna sin escritor ni lector en src/. Candidata a DROP en próxima limpieza de schema.
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

// ── Screen Time interno ──────────────────────────────────────────────────────
// Sesión de uso de la app. Una fila por "bloque continuo de actividad". El
// cliente manda heartbeats cada ~30 s; el servidor cierra la sesión al no
// recibir heartbeats por USAGE_IDLE_MS (90 s). Las siguientes métricas salen
// de agregar durationMs por usuario/día/superficie.
model UsageSession {
  id         String    @id @default(cuid())
  userId     String
  startedAt  DateTime  @default(now())
  lastPingAt DateTime  @default(now())
  endedAt    DateTime? // null mientras la sesión está viva
  durationMs Int       @default(0) // acumulado desde el primer heartbeat
  surface    String    @default("app") // "chat" | "app"
  userAgent  String?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([userId, lastPingAt])
  @@index([endedAt])
}

// ── Mensajes directos admin → usuario ────────────────────────────────────────
// Superadmin escribe a un usuario desde /admin/users/[id]. Se envía email +
// Notification in-app (canal "admin"). Estado tipo WhatsApp:
//   sentAt       → siempre, cuando el admin pulsa enviar.
//   deliveredAt  → cuando los canales (email, notification) quedan encolados
//                  OK → 1 tick gris en la UI del admin.
//   readAt       → cuando el usuario abre la notificación in-app o el pixel
//                  del email se dispara → 2 ticks verdes.
model AdminMessage {
  id             String    @id @default(cuid())
  userId         String
  createdByAdmin String? // id opaco del admin emisor (auditoría)
  subject        String
  body           String    @db.Text
  channels       String    @default("in_app,email") // CSV: "in_app" | "email"
  sentAt         DateTime  @default(now())
  deliveredAt    DateTime?
  readAt         DateTime?
  notificationId String? // id de Notification creada; null si no se pudo
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
  @@index([createdByAdmin, sentAt])
  @@index([readAt])
}

/// Weekly letter from the mentor — a short reflective piece generated each
/// Sunday from the user's own messages of that week. Lives in-app only; an
/// optional email notification (no content) can nudge the user to come read it.
model WeeklyLetter {
  id              String    @id @default(cuid())
  userId          String
  weekStart       DateTime // Monday 00:00 UTC of the covered week
  weekEnd         DateTime // Sunday 23:59 UTC of the covered week
  subject         String
  body            String    @db.Text
  quotes          Json // textual quotes extracted from the user's messages
  state           String // dominant UserState in the window
  published       Boolean   @default(true) // false when generated in dry-run — not shown to user
  skippedReason   String? // if null and not published → generated but withheld by admin
  emailNotifiedAt DateTime? // when the email notification was sent (null if not yet or disabled)
  readAt          DateTime?
  openedAt        DateTime?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@index([userId, readAt])
  @@index([published, createdAt])
}

model CrisisEvent {
  id        String   @id @default(cuid())
  userId    String
  level     String
  message   String
  response  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([level, createdAt])
  @@index([userId, createdAt])
  @@index([userId, level, createdAt])
}

model Goal {
  id           String            @id @default(cuid())
  userId       String
  title        String
  status       GoalStatus        @default(active)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  actions      Action[]
  avatarVideos GoalAvatarVideo[]

  @@index([userId, status, createdAt])
  @@index([status])
}

model Action {
  id              String           @id @default(cuid())
  goalId          String
  description     String
  completed       Boolean          @default(false)
  createdAt       DateTime         @default(now())
  goal            Goal             @relation(fields: [goalId], references: [id], onDelete: Cascade)
  avoidanceEvents AvoidanceEvent[]

  @@index([goalId, createdAt])
  @@index([goalId, completed])
}

model AvoidanceEvent {
  id        String   @id @default(cuid())
  userId    String
  actionId  String
  type      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    Action   @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([actionId, createdAt])
  @@index([actionId, type, createdAt])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  status               SubscriptionStatus
  plan                 SubscriptionPlan
  stripeSubscriptionId String?            @unique
  stripeCustomerId     String?
  stripePriceId        String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  cancelledAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([status, plan, createdAt])
  @@index([stripeSubscriptionId])
  @@index([stripeCustomerId])
}

model Profile {
  id               String        @id @default(cuid())
  code             String        @unique
  type             String
  title            String
  description      String
  operationalFocus String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  userProfiles     UserProfile[]
  challenges       Challenge[]

  @@index([type, updatedAt])
}

model UserProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  profileId       String
  clarityScore    Int
  autoestimaScore Int
  energiaScore    Int
  disciplinaScore Int
  socialScore     Int
  totalScore      Int
  rawAnswers      Json // ⚠️ deprecated 2026-04-23: columna sin escritor ni lector en src/. Candidata a DROP en próxima limpieza de schema.
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile         Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, updatedAt])
  @@index([totalScore, updatedAt])
}

model Challenge {
  id               String          @id @default(cuid())
  slug             String          @unique
  profileId        String?
  type             String
  title            String
  description      String
  difficulty       Int
  durationDays     Int
  estimatedMinutes Int
  instructions     String
  successMetric    String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  profile          Profile?        @relation(fields: [profileId], references: [id], onDelete: SetNull)
  userChallenges   UserChallenge[]

  @@index([type, difficulty])
  @@index([profileId, difficulty])
}

model UserChallenge {
  id             String    @id @default(cuid())
  userId         String
  challengeId    String
  status         String    @default("active")
  startedAt      DateTime  @default(now())
  endsAt         DateTime?
  completedDays  Int       @default(0)
  totalDays      Int
  progress       Int       @default(0)
  lastCheckInAt  DateTime?
  validationNote String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge      Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([userId, status, startedAt])
  @@index([userId, updatedAt])
  @@index([challengeId, status])
}

model FutureMessage {
  id          String    @id @default(cuid())
  userId      String
  title       String
  content     String
  unlockAt    DateTime
  deliveredAt DateTime?
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, unlockAt])
  @@index([status, unlockAt])
}

// ── Cápsula del tiempo ────────────────────────────────────────────────────────
// "Esto eras hace X días". Dos modos:
//   - snapshot: payload generado por cron a partir del estado del usuario en T0,
//                se "abre" en T0+windowDays.
//   - letter:    texto escrito por el usuario, se entrega en deliverAt.
// Ambos comparten la misma tabla y la misma pantalla /app/capsulas.
enum CapsuleKind {
  snapshot
  letter
}

enum CapsuleStatus {
  pending // creada, deliverAt aún en el futuro
  ready // deliverAt alcanzado, esperando que el usuario abra
  delivered // abierta o entregada por email
  expired // 60 días sin abrir tras ready
}

model Capsule {
  id          String        @id @default(cuid())
  userId      String
  kind        CapsuleKind
  status      CapsuleStatus @default(pending)
  createdAt   DateTime      @default(now())
  deliverAt   DateTime
  deliveredAt DateTime?
  openedAt    DateTime?
  payload     Json
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, deliverAt])
  @@index([deliverAt, status])
}

model Streak {
  id              String    @id @default(cuid())
  userId          String    @unique
  currentDays     Int       @default(0)
  bestDays        Int       @default(0)
  lastCheckInDate DateTime?
  status          String    @default("inactive")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
}

// ─── Psychologist tools ────────────────────────────────────────────────────────

/// Private clinical notes written by the psychologist for a user.
model ClinicalNote {
  id        String   @id @default(cuid())
  userId    String
  content   String
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// A standardised scale (PHQ-9, GAD-7, custom) assigned to a user by the psychologist.
model Assessment {
  id        String              @id @default(cuid())
  userId    String
  type      String // "phq9" | "gad7" | "custom"
  title     String
  questions Json // Array<{ id: string; text: string; scale: number }>
  status    String              @default("pending") // "pending" | "completed"
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  response  AssessmentResponse?

  @@index([userId, status, createdAt])
}

/// User's responses to an assessment.
model AssessmentResponse {
  id           String     @id @default(cuid())
  assessmentId String     @unique
  userId       String
  answers      Json // Array<{ questionId: string; score: number }>
  totalScore   Int
  severity     String // "minimal" | "mild" | "moderate" | "moderately_severe" | "severe"
  completedAt  DateTime   @default(now())
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
}

// ─── User features ─────────────────────────────────────────────────────────────

/// A win/victory the user records manually.
model Win {
  id               String   @id @default(cuid())
  userId           String
  note             String
  sharedWithFamily Boolean  @default(false)
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Scheduled action reminder sent via Telegram.
model ActionReminder {
  id             String    @id @default(cuid())
  userId         String
  actionText     String
  remindAt       DateTime
  sent           Boolean   @default(false)
  sentAt         DateTime?
  conversationId String?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, remindAt])
  @@index([sent, remindAt])
}

/// Per-user app preferences.
model UserPreferences {
  id                        String   @id @default(cuid())
  userId                    String   @unique
  aiTone                    String   @default("directo") // "directo" | "socratico" | "calido"
  reminderTime              String? // "HH:MM" local time for daily check-in nudge
  reminderEnabled           Boolean  @default(true)
  weeklyEmailEnabled        Boolean  @default(true)
  notifyInsights            Boolean  @default(true)
  notifyGoals               Boolean  @default(true)
  notifyUpdates             Boolean  @default(false)
  avatarVideosEnabled       Boolean  @default(true) // opt-out for weekly avatar videos
  weeklyLetterDisabled      Boolean  @default(false) // opt-out for the in-app weekly letter
  weeklyLetterEmailDisabled Boolean  @default(false) // opt-out only for the email notification; letter still appears in-app
  capsuleEmailDisabled      Boolean  @default(false) // opt-out for capsule-ready email notification (capsules still appear in-app)
  genderForm                String? // 'feminine' | 'masculine' | 'neutral' | null. NULL = el coach usa lenguaje neutro (sin conjugaciones de género)
  timezone                  String   @default("Europe/Madrid")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── System Admin Users (RBAC) ────────────────────────────────────────────────

enum SystemRole {
  superadmin
  admin
  clinical
  marketing
  support
  content
  ops
  coach
}

/// Internal team member with role-based access to the admin panel.
model AdminUser {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  role         SystemRole @default(admin)
  passwordHash String
  isActive     Boolean    @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([role, isActive])
  @@index([email])
}

// ─── Admin internal notes (pending follow-ups, reminders) ─────────────────────

/// Lightweight internal note board visible to any admin. Used to track
/// pending checks, follow-ups, migrations-to-apply, env-vars-to-verify,
/// and other things that should not be forgotten between sessions.
model AdminNote {
  id         String    @id @default(cuid())
  title      String
  body       String?   @db.Text
  tag        String    @default("general") // "referrals" | "migration" | "env" | "cron" | "ui" | "incident" | "general"
  priority   String    @default("medium") // "low" | "medium" | "high"
  status     String    @default("open") // "open" | "done"
  createdBy  String?
  resolvedBy String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([tag, status])
  @@index([priority, status])
}

// ─── Admin task queue (Telegram → Claude Code) ────────────────────────────────

/// Instructions sent by the admin via Telegram, queued for local execution.
model AdminTask {
  id          String    @id @default(cuid())
  instruction String    @db.Text
  source      String    @default("telegram")
  status      String    @default("pending") // "pending" | "done" | "skipped"
  result      String?   @db.Text
  createdAt   DateTime  @default(now())
  doneAt      DateTime?

  @@index([status, createdAt])
}

// ─── Beta / waitlist & invitations ────────────────────────────────────────────

/// Someone who completed the 3-mission onboarding flow to request beta access.
model WaitlistEntry {
  id         String   @id @default(cuid())
  email      String   @unique
  mission1   String   @db.Text
  mission2   String   @db.Text
  mission3   String   @db.Text
  status     String   @default("approved") // "approved" | "rejected"
  inviteCode String? // if they came via invite
  createdAt  DateTime @default(now())

  @@index([status, createdAt])
}

/// An invitation code a user earns via milestones (streak 7d, goal complete, 30d active).
model Invitation {
  id           String    @id @default(cuid())
  code         String    @unique @default(cuid())
  userId       String
  reason       String? // "streak_7d" | "streak_30d" | "goal_complete" | "active_30d" | "manual"
  usedByEmail  String?
  usedByUserId String?
  usedAt       DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation("InvitationsSent", fields: [userId], references: [id], onDelete: Cascade)
  usedByUser   User?     @relation("InvitationsReceived", fields: [usedByUserId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([usedAt])
  @@index([usedByUserId])
  @@index([reason])
}

// ─── Family / trusted contact system ──────────────────────────────────────────

/// A person the user trusts to have limited visibility and receive crisis alerts.
model TrustedContact {
  id       String  @id @default(cuid())
  userId   String  @unique
  name     String
  email    String
  phone    String?
  relation String? // "madre" | "padre" | "pareja" | "amigo" | "hermano/a" | "terapeuta"

  /// Token embedded in the family portal URL — acts as access credential.
  accessToken String @unique @default(cuid())

  /// What data the user allows the family member to see.
  shareProgress Boolean @default(false) // emotional trend + goal progress
  shareWins     Boolean @default(false) // notified when user records a win
  shareStreak   Boolean @default(false) // streak milestone notifications

  /// Notification triggers.
  notifyOnCrisis     Boolean @default(true)
  notifyOnInactivity Boolean @default(true)
  inactivityDays     Int     @default(3) // alert after N days without activity

  /// Metadata / audit.
  inviteSentAt   DateTime?
  lastAccessAt   DateTime? // last time family opened the portal
  lastNotifiedAt DateTime? // last outbound notification of any kind

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  supportMessages SupportMessage[]

  @@index([userId])
  @@index([accessToken])
}

/// A message of support sent by the trusted contact to the user (shown in-app).
model SupportMessage {
  id               String    @id @default(cuid())
  userId           String // recipient (the app user)
  trustedContactId String?
  fromName         String // display name shown to user
  content          String    @db.Text
  scheduledAt      DateTime? // optional delayed delivery
  deliveredAt      DateTime? // when shown to user
  readAt           DateTime? // when user tapped "read"
  createdAt        DateTime  @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  trustedContact TrustedContact? @relation(fields: [trustedContactId], references: [id], onDelete: SetNull)

  @@index([userId, deliveredAt])
  @@index([trustedContactId, createdAt])
}

/// A ping ("are you ok?") sent by the trusted contact; user can dismiss it.
model FamilyPing {
  id               String    @id @default(cuid())
  userId           String
  trustedContactId String
  respondedAt      DateTime?
  response         String? // "ok" | "not_ok" | null (unanswered)
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([trustedContactId, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Low-pressure guidance actions for TRANSITIONAL_VOID state.
model UserAction {
  id        String   @id @default(cuid())
  userId    String
  type      String // e.g. "IDENTIFY_WHAT_ENDED" | "DETECT_ESCAPE" | "ALLOW_UNCERTAINTY"
  status    String   @default("PENDING") // "PENDING" | "DONE"
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, status])
}

/// Result of the public diagnostic quiz (anonymous users included).
model QuizResult {
  id        String   @id @default(cuid())
  userId    String // anonymous or authenticated user id
  state     String // "bloqueo" | "ansiedad" | "duda" | "claridad" | "neutral"
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ─── LLM Usage Tracking ───────────────────────────────────────────────────────

/// One record per LLM call — tokens, latency, prompt/response, source context.
/// PRIVACY: prompt/response contain sensitive user data and should be purged
/// after retentionDays. A scheduled job should NULL-ify prompt + response
/// for records older than purgableAfter, keeping only metrics.
model LlmLog {
  id               String    @id @default(cuid())
  userId           String?
  model            String
  source           String    @default("chat") // "chat" | "impulse" | "checkin" | "cron" | etc.
  prompt           String?   @db.Text // nullable — purged after retention period
  response         String?   @db.Text // nullable — purged after retention period
  promptTokens     Int       @default(0)
  completionTokens Int       @default(0)
  totalTokens      Int       @default(0)
  costUsd          Float     @default(0)
  latencyMs        Int
  purgedAt         DateTime? // when prompt/response were nullified
  createdAt        DateTime  @default(now())
  user             User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([model, createdAt])
  @@index([source, createdAt])
  @@index([model])
  @@index([source])
  @@index([purgedAt, createdAt])
}

// ─── Clinical Dashboard ───────────────────────────────────────────────────────

/// Intervention sent by a clinician/admin to a specific user.
model Intervention {
  id        String             @id @default(cuid())
  userId    String
  adminId   String // ADMIN_USERNAME who sent it
  type      String // "message" | "recommendation" | "resource" | "assessment"
  content   String             @db.Text
  status    InterventionStatus @default(sent)
  metadata  Json?
  sentAt    DateTime           @default(now())
  readAt    DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user User @relation("UserInterventions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
  @@index([userId, status])
  @@index([adminId, sentAt])
}

// ─── Journey System (Itinerarios Guiados) ────────────────────────────────────

/// A structured development journey (e.g. "Autoconocimiento", "Gestión Emocional").
model Journey {
  id            String          @id @default(cuid())
  slug          String          @unique
  title         String
  description   String          @db.Text
  phase         String // "autoconocimiento" | "gestion_emocional" | "proposito" | "accion"
  order         Int             @default(0)
  iconEmoji     String          @default("🌱")
  durationWeeks Int             @default(4)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  modules       JourneyModule[]
  userJourneys  UserJourney[]

  @@index([phase, order])
  @@index([isActive, order])
}

/// A module within a journey.
model JourneyModule {
  id                  String     @id @default(cuid())
  journeyId           String
  slug                String
  title               String
  description         String     @db.Text
  order               Int        @default(0)
  unlockAfterModuleId String?
  iconEmoji           String     @default("📘")
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  journey             Journey    @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  exercises           Exercise[]

  @@unique([journeyId, slug])
  @@index([journeyId, order])
}

/// A single guided exercise within a module.
model Exercise {
  id               String         @id @default(cuid())
  moduleId         String
  slug             String
  title            String
  description      String         @db.Text
  type             String // "reflection" | "writing" | "action" | "assessment" | "breathing" | "visualization"
  order            Int            @default(0)
  estimatedMinutes Int            @default(10)
  instructions     Json // Array<{ step: number; title: string; prompt: string; inputType: "text" | "choice" | "scale" | "none" }>. Se escribe solo desde prisma/seeds/journeys.ts (contenido editorial, no runtime).
  debrief          String?        @db.Text
  tags             String[]       @default([])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  module           JourneyModule  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  userExercises    UserExercise[]

  @@unique([moduleId, slug])
  @@index([moduleId, order])
  @@index([type])
}

/// Tracks a user's enrollment and progress in a journey.
model UserJourney {
  id              String    @id @default(cuid())
  userId          String
  journeyId       String
  status          String    @default("active") // "active" | "paused" | "completed" | "abandoned"
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  currentModuleId String?
  progress        Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  journey         Journey   @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@unique([userId, journeyId])
  @@index([userId, status])
  @@index([journeyId, status])
}

/// Tracks individual exercise completion and reflections.
model UserExercise {
  id          String    @id @default(cuid())
  userId      String
  exerciseId  String
  status      String    @default("pending") // "pending" | "in_progress" | "completed" | "skipped"
  responses   Json?
  reflection  String?   @db.Text
  startedAt   DateTime?
  completedAt DateTime?
  aiDebrief   String?   @db.Text
  rating      Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise    Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([userId, exerciseId])
  @@index([userId, status])
  @@index([exerciseId, status])
  @@index([userId, completedAt])
}

/// User feedback, suggestions, and bug reports.
model Feedback {
  id                  String   @id @default(cuid())
  userId              String
  type                String   @default("suggestion") // "suggestion" | "bug" | "other" | "nps"
  rating              Int? // 1-5 star rating (null for text-only feedback)
  message             String   @db.Text
  page                String? // URL path where feedback was submitted
  // When true, this feedback is curated by the marketing team and exposed
  // publicly as a testimonial via /api/testimonials. Admin-only toggle.
  isPublicTestimonial Boolean  @default(false)
  testimonialOrder    Int? // optional ordering on the landing page (lower first)
  createdAt           DateTime @default(now())
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([isPublicTestimonial, testimonialOrder])
}

/// Latido (gem) transactions — gamification currency
model LatidoTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int // positive = earned, negative = spent
  reason    String // "checkin", "action_complete", "streak_3d", "streak_7d", "streak_21d", "goal_complete", "community_reply", "victory_shared", "first_message_today", "spend_unlock", "spend_gift", "spend_theme"
  meta      String? // extra context (e.g. which feature unlocked)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([reason, createdAt])
}

/// Scheduled email queue — onboarding sequences, drip campaigns, etc.
model ScheduledEmail {
  id          String    @id @default(cuid())
  userId      String
  template    String // "onboarding_day1" | "onboarding_day3" | "onboarding_day7" | "quiz_followup_day3" | etc.
  scheduledAt DateTime
  sentAt      DateTime?
  cancelled   Boolean   @default(false)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([scheduledAt, sentAt])
  @@index([userId, template])
}

// ─── B2B: Organizations (Multitenant) ─────────────────────────────────────────

/// An organization (company, clinic, school, training center) that groups users.
model Organization {
  id           String      @id @default(cuid())
  name         String
  slug         String      @unique // URL-friendly identifier
  type         String      @default("company") // "company" | "clinic" | "school" | "training_center"
  plan         String      @default("team") // "team" | "enterprise"
  maxUsers     Int         @default(50)
  isActive     Boolean     @default(true)
  contactName  String?
  contactEmail String?
  logoUrl      String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  users        User[]
  orgAdmins    OrgAdmin[]
  orgInvites   OrgInvite[]
  classrooms   Classroom[]

  @@index([slug])
  @@index([type, isActive])
}

/// Admin users for an organization (HR managers, therapists, teachers).
/// Separate from User — they don't chat, they view aggregate data.
model OrgAdmin {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  name           String
  role           String       @default("hr") // "hr" | "therapist" | "admin" | "teacher"
  classroomId    String? // if teacher, which classroom they manage
  passwordHash   String
  lastLoginAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  classroom      Classroom?   @relation(fields: [classroomId], references: [id])

  @@unique([organizationId, email])
  @@index([email])
  @@index([classroomId])
}

/// Invitation link for users to join a specific organization.
model OrgInvite {
  id             String       @id @default(cuid())
  organizationId String
  code           String       @unique @default(cuid())
  email          String? // if set, only this email can use the invite
  role           String? // optional: pre-assign a label like "empleado" | "paciente"
  maxUses        Int          @default(1)
  usedCount      Int          @default(0)
  expiresAt      DateTime?
  createdBy      String // admin who created it
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([code])
}

/// A classroom/group within an organization. Teachers manage classrooms.
model Classroom {
  id             String          @id @default(cuid())
  organizationId String
  name           String // "3º ESO A", "Grupo Mindfulness", etc.
  description    String?
  teacherId      String? // OrgAdmin id of the teacher (denormalized for quick access)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]
  teachers       OrgAdmin[]
  codes          ClassroomCode[]

  @@index([organizationId, isActive])
  @@index([organizationId, createdAt])
}

/// A registration code that assigns users to a classroom on signup.
model ClassroomCode {
  id          String    @id @default(cuid())
  classroomId String
  code        String    @unique // short human-friendly code: "MIND-2026-A3"
  label       String? // optional label: "Código para padres", "Turno mañana"
  maxUses     Int       @default(0) // 0 = unlimited
  usedCount   Int       @default(0)
  isActive    Boolean   @default(true)
  expiresAt   DateTime?
  createdBy   String // OrgAdmin id who created it
  createdAt   DateTime  @default(now())
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([classroomId, isActive])
}

// ─── Personal Project System (Proyecto Personal — DFC) ───────────────────────

/// A self-directed personal project following SENTIR > IMAGINAR > ACTUAR > REFLEXIONAR.
model PersonalProject {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?   @db.Text
  phase       String    @default("feel") // "feel" | "imagine" | "act" | "reflect"
  status      String    @default("active") // "active" | "paused" | "completed" | "abandoned"
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  phaseEntries ProjectPhaseEntry[]
  focusAreas   ProjectFocusArea[]
  reflections  ProjectReflection[]
  insights     ProjectInsight[]

  @@index([userId, status])
  @@index([userId, phase, status])
}

/// Q&A interaction within a phase. Questions can be curated or AI-generated.
model ProjectPhaseEntry {
  id           String   @id @default(cuid())
  projectId    String
  phase        String
  promptKey    String // Identifies which prompt/exercise
  question     String   @db.Text
  response     String?  @db.Text
  aiReflection String?  @db.Text
  status       String   @default("pending") // "pending" | "completed" | "skipped"
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project PersonalProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, phase, order])
}

/// Self-defined focus area — user defines, AI challenges.
model ProjectFocusArea {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String?  @db.Text
  priority    Int      @default(0)
  status      String   @default("active") // "active" | "completed" | "dropped"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project PersonalProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  steps   ProjectStep[]

  @@index([projectId, status])
}

/// Concrete action step within a focus area (ACT phase).
model ProjectStep {
  id          String    @id @default(cuid())
  focusAreaId String
  description String
  completed   Boolean   @default(false)
  completedAt DateTime?
  dueDate     DateTime?
  reflection  String?   @db.Text
  order       Int       @default(0)
  createdAt   DateTime  @default(now())

  focusArea ProjectFocusArea @relation(fields: [focusAreaId], references: [id], onDelete: Cascade)

  @@index([focusAreaId, completed])
}

/// Free-form reflections captured at any point.
model ProjectReflection {
  id          String   @id @default(cuid())
  projectId   String
  phase       String
  type        String   @default("free") // "free" | "prompted" | "milestone" | "phase_transition"
  content     String   @db.Text
  aiChallenge String?  @db.Text
  createdAt   DateTime @default(now())

  project PersonalProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

/// AI-generated observations about patterns the user might not see.
model ProjectInsight {
  id           String   @id @default(cuid())
  projectId    String
  type         String // "blind_spot" | "pattern" | "growth" | "avoidance" | "shift"
  content      String   @db.Text
  phase        String
  acknowledged Boolean  @default(false)
  createdAt    DateTime @default(now())

  project PersonalProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, acknowledged])
}

// ─── Emotional Diary ─────────────────────────────────────────────────────────

/// Free-form daily diary entry with emotional tags.
model DiaryEntry {
  id        String   @id @default(cuid())
  userId    String
  content   String   @db.Text // plain-text fallback / search index
  blocks    Json? // BlockNote block array (rich content)
  mood      String? // "great" | "good" | "neutral" | "bad" | "awful"
  tags      String[] @default([]) // user-selected emotional tags
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, mood, createdAt])
}

// ─── Blog / News ────────────────────────────────────────────────────────────

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?   @db.Text // short summary for cards / SEO
  content     String    @db.Text // plain-text fallback / search
  blocks      Json? // BlockNote rich content
  coverImage  String? // URL to cover image
  tags        String[]  @default([])
  status      String    @default("draft") // draft | published | archived
  authorName  String    @default("Equipo Tres Mil Millones de Latidos")
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  syndications BlogSyndication[]

  @@index([status, publishedAt])
  @@index([slug])
}

/// Almacena refresh tokens OAuth de Mario para publicar en plataformas
/// externas (Reddit, futuro Twitter, LinkedIn). Singleton por plataforma:
/// solo hay UN usuario admin que publica.
model IntegrationToken {
  id           String    @id @default(cuid())
  platform     String    @unique // "reddit" | future
  accessToken  String    @db.Text
  refreshToken String?   @db.Text
  expiresAt    DateTime?
  scope        String?
  username     String? // handle en la plataforma (u/luciernaga-ai, @mario, etc.)
  metadata     Json? // datos extra
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// Discovery agent — conversaciones encontradas en foros públicos donde
/// tu producto aporta valor real. El agente las encuentra, las puntúa con
/// LLM, redacta un borrador en tu voz, y tú apruebas/rechazas desde admin.
/// Nunca se publica nada sin tu OK. Cuentas usadas son las tuyas (no falsas).
model DiscoveryMatch {
  id              String    @id @default(cuid())
  platform        String // "reddit" | "hn" | future: "quora", "twitter"
  externalId      String // post/thread ID en la plataforma
  externalUrl     String
  subredditOrTag  String? // r/SaludMentalES, story, etc.
  title           String?
  excerpt         String?   @db.Text // primeras N líneas del post
  authorHandle    String?
  postedAt        DateTime?
  matchedKeywords String[]  @default([])

  llmScore     Int? // 0-10 puntuación de relevancia
  llmReason    String?   @db.Text // razonamiento del LLM
  draftResponse String?  @db.Text // borrador en brand voice

  /// pending | approved | rejected | published | failed
  status         String    @default("pending")
  approvedAt     DateTime?
  rejectedAt     DateTime?
  publishedAt    DateTime?
  publishedUrl   String? // URL del comentario publicado
  publishError   String?   @db.Text

  notifiedAt     DateTime? // cuándo se envió a Telegram

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([platform, externalId])
  @@index([status, createdAt])
  @@index([platform, llmScore])
}

/// Tracks where a BlogPost has been syndicated (Medium, Dev.to, Hashnode, etc.)
/// Re-publication keeps canonical URL pointing to tresmilmillonesdelatidos.es to
/// avoid duplicate-content SEO penalties.
model BlogSyndication {
  id           String    @id @default(cuid())
  blogPostId   String
  blogPost     BlogPost  @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  platform     String // "medium" | "devto" | "hashnode"
  status       String    @default("pending") // pending | success | failed | skipped
  externalId   String? // ID returned by the platform after publish
  externalUrl  String? // public URL on the destination platform
  errorMessage String?   @db.Text
  attemptedAt  DateTime  @default(now())
  succeededAt  DateTime?

  @@unique([blogPostId, platform])
  @@index([blogPostId])
  @@index([status])
}

// ─── Badges / Achievements ───────────────────────────────────────────────────

/// A badge the user has earned.
model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badge    String // badge key: "first_project", "streak_7d", "streak_30d", "phase_completed", "first_goal", "invite_used", "diary_7d", "community_first"
  earnedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badge])
  @@index([userId])
}

// ─── Community System ────────────────────────────────────────────────────────

/// Structured community post — guided format, not free text.
model CommunityPost {
  id         String            @id @default(cuid())
  userId     String
  circleId   String?
  spaceId    String?
  type       String            @default("reflection") // "reflection" | "victory" | "commitment" | "question"
  feeling    String? // "Hoy me siento..."
  blocker    String? // "Lo que me frena es..."
  step       String? // "Mi paso de hoy es..."
  content    String?           @db.Text
  phase      String?
  anonymous  Boolean           @default(true)
  likes      Int               @default(0)
  hidden     Boolean           @default(false)
  createdAt  DateTime          @default(now())
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle     Circle?           @relation(fields: [circleId], references: [id], onDelete: SetNull)
  space      CommunitySpace?   @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  heartbeats Heartbeat[]
  reports    CommunityReport[]

  @@index([createdAt])
  @@index([hidden, createdAt])
  @@index([circleId, createdAt])
  @@index([spaceId, createdAt])
  @@index([type, createdAt])
}

/// Reports filed against community posts (moderation queue).
/// Consumed by src/app/api/community/report/route.ts — 3 pending reports
/// auto-hide the post; self_harm reports also page admin via Telegram.
model CommunityReport {
  id                   String              @id @default(cuid())
  postId               String? // nullable — reports can target posts, anon items or daily-round items
  anonQuestionId       String?
  anonAnswerId         String?
  dailyRoundResponseId String?
  dailyRoundMirrorId   String?
  reporterId           String
  reason               String // "harmful" | "self_harm" | "harassment" | "spam" | "other"
  details              String?
  status               String              @default("pending") // "pending" | "reviewed" | "dismissed"
  createdAt            DateTime            @default(now())
  post                 CommunityPost?      @relation(fields: [postId], references: [id], onDelete: Cascade)
  anonQuestion         AnonQuestion?       @relation("ReportOnQuestion", fields: [anonQuestionId], references: [id], onDelete: Cascade)
  anonAnswer           AnonAnswer?         @relation("ReportOnAnswer", fields: [anonAnswerId], references: [id], onDelete: Cascade)
  dailyRoundResponse   DailyRoundResponse? @relation(fields: [dailyRoundResponseId], references: [id], onDelete: Cascade)
  dailyRoundMirror     DailyRoundMirror?   @relation(fields: [dailyRoundMirrorId], references: [id], onDelete: Cascade)
  reporter             User                @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([reporterId, createdAt])
  @@index([postId, status])
  @@index([anonQuestionId, status])
  @@index([anonAnswerId, status])
  @@index([dailyRoundResponseId, status])
  @@index([dailyRoundMirrorId, status])
  @@index([status, createdAt])
}

// ─── Community: Ronda Diaria (Cafetería) ─────────────────────────────────────

/// Prompt único del día en la Cafetería. Creado por el cron daily-round-create.
model DailyRound {
  id        String               @id @default(cuid())
  date      DateTime             @unique @db.Date
  prompt    String               @db.Text
  createdAt DateTime             @default(now())
  responses DailyRoundResponse[]

  @@index([date])
}

/// Respuesta del usuario a la ronda del día (una por usuario por ronda).
model DailyRoundResponse {
  id        String               @id @default(cuid())
  roundId   String
  userId    String
  content   String               @db.Text
  anonymous Boolean              @default(true)
  hidden    Boolean              @default(false)
  createdAt DateTime             @default(now())
  round     DailyRound           @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions DailyRoundReaction[]
  mirrors   DailyRoundMirror[]
  reports   CommunityReport[]

  @@unique([roundId, userId])
  @@index([roundId, createdAt])
  @@index([userId, createdAt])
}

/// Reacción emoji a una respuesta (una por usuario por respuesta; re-tap sustituye).
model DailyRoundReaction {
  id         String             @id @default(cuid())
  responseId String
  userId     String
  emoji      String // allowlist aplicada en API
  createdAt  DateTime           @default(now())
  response   DailyRoundResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([responseId, userId])
  @@index([responseId])
}

/// Pregunta-espejo enviada a una respuesta. 1 por autor por respuesta, max 3 por respuesta.
model DailyRoundMirror {
  id         String             @id @default(cuid())
  responseId String
  authorId   String
  question   String             @db.Text
  hidden     Boolean            @default(false)
  createdAt  DateTime           @default(now())
  response   DailyRoundResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  author     User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reports    CommunityReport[]

  @@unique([responseId, authorId])
  @@index([responseId, createdAt])
  @@index([authorId, createdAt])
}

// ─── Marketing Dashboard ──────────────────────────────────────────────────────

model BroadcastLog {
  id             String    @id @default(cuid())
  channel        String // "telegram" | "email"
  segment        String // audience segment key
  message        String
  subject        String? // only for email
  recipientCount Int
  successCount   Int       @default(0)
  failureCount   Int       @default(0)
  status         String    @default("pending") // "pending" | "sending" | "completed" | "failed"
  sentBy         String
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  @@index([channel, createdAt])
  @@index([status, createdAt])
}

// ─── Audit Log (RGPD / LOPD compliance) ─────────────────────────────────────

/// Immutable record of who accessed or modified sensitive clinical data.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String // who performed the action
  actorType  String // "user" | "admin" | "orgAdmin" | "system"
  action     String // "read" | "create" | "update" | "delete" | "export" | "login"
  resource   String // model name: "ClinicalNote" | "Assessment" | "User" | etc.
  resourceId String? // id of the affected record
  metadata   Json? // extra context (e.g. fields changed, export format)
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([resource, resourceId])
  @@index([action, createdAt])
  @@index([createdAt])
}

// ─── Community: Circles of Transformation ────────────────────────────────────

enum CirclePhase {
  bloqueo
  exploracion
  decision
  accion
  consistencia
}

enum CircleRole {
  member
  mentor_par
  coach
  psychologist
}

/// A small async group of 4 people sharing the same emotional pattern recently.
/// Lifecycle: 6-week cycle, then closing letter + re-matching.
model Circle {
  id            String                @id @default(cuid())
  name          String
  matchPattern  String // dominantPattern that grouped these members
  matchEmotion  String // primaryEmotion that grouped these members
  maxMembers    Int                   @default(4)
  description   String?
  startsAt      DateTime              @default(now())
  cycleEndsAt   DateTime? // when the 6-week cycle closes and members get a closing letter
  isActive      Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  members       CircleMember[]
  posts         CommunityPost[]
  commitments   DailyCommitment[]
  sessions      LiveSession[]
  pulses        CirclePulse[]
  closingLetters CircleClosingLetter[]

  @@index([isActive, cycleEndsAt])
  @@index([matchPattern, matchEmotion, isActive])
}

/// Weekly asynchronous prompt for the circle — open for 7 days, then auto-closed.
model CirclePulse {
  id           String                @id @default(cuid())
  circleId     String
  prompt       String                @db.Text
  promptSource String // "emergent" | "manual" | "welcome"
  weekStart    DateTime // Monday 00:00 UTC of the covered week
  weekEnd      DateTime // Sunday 23:59 UTC of the covered week
  status       String                @default("open") // "open" | "closed"
  openedAt     DateTime              @default(now())
  closedAt     DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  circle       Circle                @relation(fields: [circleId], references: [id], onDelete: Cascade)
  responses    CirclePulseResponse[]
  reflections  MentorReflection[]

  @@unique([circleId, weekStart])
  @@index([status, weekEnd])
  @@index([circleId, weekStart])
}

/// One asynchronous response from a member to a CirclePulse.
model CirclePulseResponse {
  id          String      @id @default(cuid())
  pulseId     String
  userId      String
  content     String      @db.Text
  anonymous   Boolean     @default(true)
  flagged     Boolean     @default(false)
  submittedAt DateTime    @default(now())
  editedAt    DateTime?
  pulse       CirclePulse @relation(fields: [pulseId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pulseId, userId])
  @@index([pulseId, submittedAt])
  @@index([userId, submittedAt])
}

/// Mentor-generated private reflection delivered to one member after a Pulse closes.
/// Reflects what from the group's responses resonates with this specific user's case.
/// Replaces the old peer "echo" mechanic.
model MentorReflection {
  id           String      @id @default(cuid())
  pulseId      String
  userId       String
  content      String      @db.Text
  source       String // "auto" | "approved" — admin must approve before publishedAt is set
  generatedAt  DateTime    @default(now())
  approvedAt   DateTime?
  publishedAt  DateTime?
  readAt       DateTime?
  pulse        CirclePulse @relation(fields: [pulseId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pulseId, userId])
  @@index([userId, publishedAt])
  @@index([approvedAt])
}

model CircleMember {
  id       String     @id @default(cuid())
  circleId String
  userId   String
  role     CircleRole @default(member)
  joinedAt DateTime   @default(now())
  leftAt   DateTime?
  circle   Circle     @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([circleId, userId])
  @@index([userId])
}

/// Generated when a member exits a circle (cycle end, drift, voluntary leave).
/// Synthesises what they said and what the group reflected back. Stored permanently.
model CircleClosingLetter {
  id          String   @id @default(cuid())
  circleId    String
  userId      String
  reason      String // "cycle_end" | "drift" | "left" | "removed"
  body        String   @db.Text
  generatedAt DateTime @default(now())
  deliveredAt DateTime?
  circle      Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, generatedAt])
  @@index([circleId, generatedAt])
}

// ─── Community: Spaces ───────────────────────────────────────────────────────

/// Thematic space (e.g. "Bloqueo y procrastinación").
model CommunitySpace {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  description String?
  icon        String? // emoji
  sortOrder   Int             @default(0)
  isActive    Boolean         @default(true)
  posts       CommunityPost[]
}

/// "Latido" reaction — instead of likes.
model Heartbeat {
  id        String        @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime      @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

// ─── Community: Daily Commitments ────────────────────────────────────────────

/// "Hoy voy a..." — visible to the circle.
model DailyCommitment {
  id        String   @id @default(cuid())
  userId    String
  circleId  String
  text      String
  date      DateTime @db.Date
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle    Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@unique([userId, circleId, date])
  @@index([circleId, date])
}

// ─── Community: Live Sessions ────────────────────────────────────────────────

/// Scheduled group session with a professional.
model LiveSession {
  id          String   @id @default(cuid())
  circleId    String?
  title       String
  description String?
  hostName    String
  hostRole    String // "coach" | "psychologist"
  scheduledAt DateTime
  durationMin Int      @default(60)
  meetingUrl  String?
  isOpen      Boolean  @default(false) // open to all or circle-only
  status      String   @default("scheduled") // "scheduled" | "live" | "completed" | "cancelled"
  createdAt   DateTime @default(now())
  circle      Circle?  @relation(fields: [circleId], references: [id], onDelete: SetNull)

  @@index([scheduledAt])
  @@index([circleId, scheduledAt])
}

// ─── Community: Anonymous Questions (ask.fm style) ──────────────────────────

/// Anonymous question asked to the community or to a specific user.
model AnonQuestion {
  id             String            @id @default(cuid())
  content        String // the question text (max 500)
  authorId       String? // null = truly anonymous (not logged in — future)
  targetId       String? // null = asked to everyone; set = asked to specific user
  hidden         Boolean           @default(false) // moderation
  crisisDetected Boolean           @default(false) // flagged by content-safety as crisis
  createdAt      DateTime          @default(now())
  author         User?             @relation("QuestionsAsked", fields: [authorId], references: [id], onDelete: SetNull)
  target         User?             @relation("QuestionsReceived", fields: [targetId], references: [id], onDelete: SetNull)
  answers        AnonAnswer[]
  reports        CommunityReport[] @relation("ReportOnQuestion")

  @@index([targetId, createdAt])
  @@index([hidden, createdAt])
  @@index([crisisDetected])
  @@index([targetId, hidden, createdAt])
}

/// Answer to an anonymous question — can also be anonymous.
model AnonAnswer {
  id         String            @id @default(cuid())
  questionId String
  userId     String
  content    String // max 1000
  anonymous  Boolean           @default(false)
  likes      Int               @default(0) // kept for back-compat; new votes use AnonAnswerVote
  hidden     Boolean           @default(false)
  createdAt  DateTime          @default(now())
  question   AnonQuestion      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes      AnonAnswerVote[]
  reports    CommunityReport[] @relation("ReportOnAnswer")

  @@index([questionId, createdAt])
  @@index([questionId, hidden])
}

/// "Me ayudó" vote on an answer — one vote per user per answer.
model AnonAnswerVote {
  id        String     @id @default(cuid())
  answerId  String
  userId    String
  createdAt DateTime   @default(now())
  answer    AnonAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([answerId, userId])
  @@index([answerId])
}

// ─── Push Notifications ─────────────────────────────────────────────────────

/// Browser push subscription (one per device per user).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @db.Text
  p256dh    String // encryption key
  auth      String // auth secret
  userAgent String? // browser/device identifier
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@index([userId])
}

/// In-app notification delivered to a user (push + bell icon).
model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String
  url       String? // deep link to open on click
  icon      String? // emoji or icon key
  channel   String    @default("system") // "system" | "goal" | "streak" | "crisis" | "insight" | "challenge" | "admin"
  read      Boolean   @default(false)
  pushed    Boolean   @default(false) // was a web push sent?
  pushedAt  DateTime?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@index([userId, createdAt])
  @@index([channel, createdAt])
}

// ─── User File Library ──────────────────────────────────────────────────────

/// File uploaded by the user (images, documents). Stored as base64.
model UserFile {
  id        String   @id @default(cuid())
  userId    String
  name      String // original filename
  mimeType  String // e.g. "image/png"
  size      Int // bytes
  data      String   @db.Text // base64 data URL
  source    String   @default("upload") // "upload" | "chat" | "avatar"
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model SiteContent {
  key       String
  locale    String
  value     String   @db.Text
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@id([key, locale])
  @@index([locale])
}

model MediaAsset {
  key       String   @id
  mimeType  String
  size      Int
  data      String   @db.Text
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model SystemLog {
  id         String   @id @default(cuid())
  timestamp  DateTime @default(now())
  level      String
  tag        String
  message    String   @db.Text
  context    Json?
  userId     String?
  route      String?
  statusCode Int?
  durationMs Int?
  stack      String?  @db.Text

  @@index([level, timestamp])
  @@index([tag, timestamp])
  @@index([userId, timestamp])
  @@index([timestamp])
}

model EmailLog {
  id           String    @id @default(cuid())
  userId       String?
  to           String
  template     String
  subject      String
  status       String    @default("queued")
  providerId   String?
  errorMessage String?   @db.Text
  sentAt       DateTime?
  deliveredAt  DateTime?
  bouncedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([template, createdAt])
  @@index([to, createdAt])
}

model CronRunLog {
  id               String    @id @default(cuid())
  jobName          String
  dedupKey         String?
  status           String    @default("running")
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  durationMs       Int?
  recordsProcessed Int?
  errorMessage     String?   @db.Text
  metadata         Json? // ⚠️ deprecated 2026-04-23: columna sin escritor ni lector en src/. Candidata a DROP en próxima limpieza de schema.

  @@unique([jobName, dedupKey])
  @@index([jobName, startedAt])
  @@index([status, startedAt])
  @@index([startedAt])
}

model WebhookLog {
  id             String    @id @default(cuid())
  source         String
  event          String?
  status         String    @default("received")
  signatureValid Boolean?
  statusCode     Int?
  durationMs     Int?
  errorMessage   String?   @db.Text
  payload        Json?
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?

  @@index([source, receivedAt])
  @@index([status, receivedAt])
  @@index([receivedAt])
}

model AlertRule {
  id              String    @id @default(cuid())
  name            String
  enabled         Boolean   @default(true)
  level           String
  tagPattern      String?
  messagePattern  String?
  channel         String    @default("telegram")
  throttleMinutes Int       @default(15)
  lastFiredAt     DateTime?
  firedCount      Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([enabled, level])
}

/// Local catalog of remote Claude Code routines created via /schedule.
/// We don't manage the routine itself (claude.ai owns lifecycle) — we keep a
/// pointer + metadata so admins can see what's been scheduled, why, and pin
/// the result (PR url, notes) without leaving /admin.
model ScheduledAgent {
  id             String    @id @default(cuid())
  /// claude.ai trigger id — opaque external identifier, e.g. "trig_013N8djs..."
  triggerId      String    @unique
  name           String
  purpose        String? // human description of what the agent should achieve
  scheduledFor   DateTime? // set for one-shot routines
  cronExpression String? // set for recurring routines
  promptSummary  String    @db.Text // first ~500 chars of the prompt
  model          String?
  repo           String?
  status         String    @default("scheduled") // scheduled | ran | cancelled
  resultUrl      String? // PR or issue url left by the agent after running
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  completedAt    DateTime?

  @@index([status, scheduledFor])
  @@index([status, createdAt])
}

/// Marketing tracker added at runtime from the admin panel — no redeploy needed.
/// Loaded by the public client only after cookie consent. Providers supported:
/// hotjar, clarity, plausible, posthog. The 3 original trackers (GA4, Meta,
/// Inspectlet) remain hardcoded behind NEXT_PUBLIC_ env vars.
model CustomTracker {
  id         String   @id @default(cuid())
  provider   String // "hotjar" | "clarity" | "plausible" | "posthog"
  name       String // human label shown in admin
  identifier String // siteId / projectId / domain / projectKey (depending on provider)
  apiHost    String? // posthog: api host (default https://us.i.posthog.com); plausible: optional self-hosted host
  isActive   Boolean  @default(true)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive, provider])
}

/// Resultado del test del Eneagrama (OEPS — Open Enneagram of Personality
/// Scales, openpsychometrics.org). 90 ítems Likert 1-5 → score por tipo (1..9).
/// Se usa para adaptar el tono del mentor: tipo 1 evita normativa, tipo 6
/// quiere certezas explícitas, etc. El usuario puede repetirlo cuando quiera.
model EnneagramAssessment {
  id             String   @id @default(cuid())
  userId         String
  /// JSON: { type1: 0-40, type2: 0-40, ..., type9: 0-40 } sumas crudas.
  scoresByType   Json
  /// 1..9 — el tipo con score más alto. Si hay empate, el menor índice gana.
  dominantType   Int
  /// 1..9 — segundo tipo más alto, vecino del dominante (típicamente).
  /// Null si la diferencia con el 3º es despreciable.
  wing           Int?
  /// Versión del cuestionario (por si calibramos en el futuro).
  testVersion    String   @default("oeps-90-v1")
  /// JSON: { qXX: 1..5 } con las respuestas individuales que dio el usuario.
  /// Se guarda con consentimiento explícito (copy en la intro del test) para
  /// que el equipo pueda contextualizar el resultado al revisar la ficha y
  /// para que el propio usuario pueda revisar su histórico. Borrable.
  rawAnswers     Json?
  completedAt    DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
}

/// Solicitud de "carta humana" del equipo. Aparece como CTA en el chat tras
/// 3 turnos del usuario para dar un motivo tangible de volver: alguien del
/// equipo lee tu hilo y te escribe una recomendación personal por email.
/// El admin la responde manualmente desde /admin/team-letters.
model TeamLetterRequest {
  id            String    @id @default(cuid())
  userId        String
  email         String // snapshot al momento de pedirla (puede que user.email cambie)
  status        String    @default("pending") // "pending" | "sent" | "rejected"
  /// Snapshot del contexto al pedirla: dominantPattern, primeros mensajes,
  /// onboardingContext, latidos, messageCount. Lo guardamos al momento porque
  /// la conversación puede evolucionar antes de que el equipo escriba.
  context       Json?
  requestedAt   DateTime  @default(now())
  sentAt        DateTime?
  sentByAdminId String?
  notes         String? // borrador interno o notas del admin
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, requestedAt])
  @@index([userId, requestedAt])
}

// ─── SEO agent tables ────────────────────────────────────────────────────────
// Espejo local de métricas GA4 + Search Console y catálogo de oportunidades
// detectadas por SeoOpportunityService. Permite auditar tendencias sin
// quemar cuotas de Google APIs.

/// Snapshot diario de métricas GA4 por pagePath. Re-sync sobreescribe.
model Ga4DailyMetric {
  id                String   @id @default(cuid())
  date              DateTime @db.Date
  pagePath          String
  activeUsers       Int      @default(0)
  sessions          Int      @default(0)
  screenPageViews   Int      @default(0)
  eventCount        Int      @default(0)
  conversions       Float    @default(0)
  averageSessionSec Float    @default(0)
  bounceRate        Float    @default(0)
  syncedAt          DateTime @default(now())

  @@unique([date, pagePath])
  @@index([pagePath])
  @@index([date])
}

/// Snapshot diario por query de Search Console. Re-sync sobreescribe.
model GscDailyQuery {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  query       String
  clicks      Int      @default(0)
  impressions Int      @default(0)
  ctr         Float    @default(0)
  position    Float    @default(0)
  syncedAt    DateTime @default(now())

  @@unique([date, query])
  @@index([query])
  @@index([date])
  @@index([clicks])
  @@index([impressions])
}

/// Snapshot diario por página de Search Console. Re-sync sobreescribe.
model GscDailyPage {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  page        String
  clicks      Int      @default(0)
  impressions Int      @default(0)
  ctr         Float    @default(0)
  position    Float    @default(0)
  syncedAt    DateTime @default(now())

  @@unique([date, page])
  @@index([page])
  @@index([date])
}

/// Oportunidad SEO detectada por SeoOpportunityService.
model SeoOpportunity {
  id             String    @id @default(cuid())
  /// Tipo de oportunidad: ranking_4_20 | low_ctr_high_impressions |
  /// clicks_drop | impressions_growing_low_clicks | cannibalization |
  /// orgtraffic_low_conversion | high_conversion_low_traffic |
  /// new_content | title_meta | internal_links
  kind           String
  /// Prioridad 1 (menor) a 10 (urgente). Calculada por el detector.
  priority       Int       @default(5)
  url            String?
  query          String?
  /// Datos brutos que justifican la oportunidad (clicks, impressions,
  /// posición histórica, etc.). Estructura específica por kind.
  metrics        Json?
  recommendation String    @db.Text
  /// open | in_progress | done | dismissed
  status         String    @default("open")
  detectedAt     DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  resolvedAt     DateTime?
  /// Hash de identidad (kind + url + query) para evitar duplicados al re-correr.
  fingerprint    String    @unique

  @@index([status, priority])
  @@index([kind, status])
  @@index([detectedAt])
}
