// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "darwin-arm64"]
}

datasource db {
  provider = "postgresql"
}

model Conversation {
  id             String    @id @default(cuid())
  userId         String?
  title          String    @default("Nueva conversación")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  messages       Json      @default("[]")
  messageRecords Message[] @relation("ConversationMessages")
  user           User?     @relation("UserConversations", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, updatedAt])
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  name            String?
  role            String           @default("user")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  lastSeen        DateTime         @default(now())
  telegramId      String?          @unique
  consentGiven    Boolean          @default(false)
  consentAt       DateTime?
  source          String?
  isActive        Boolean          @default(true)
  messageCount    Int              @default(0)
  lastMessageAt   DateTime?
  conversations   Conversation[]   @relation("UserConversations")
  messages        Message[]        @relation("UserMessages")
  goals           Goal[]
  crisisEvents    CrisisEvent[]
  avoidanceEvents AvoidanceEvent[]
  subscriptions   Subscription[]
  userProfile     UserProfile?
  userChallenges  UserChallenge[]
  dailyLogs       DailyLog[]
  futureMessages  FutureMessage[]
  streak          Streak?
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  userId         String?
  role           String       @default("user") // "user" | "assistant"
  content        String
  createdAt      DateTime     @default(now())
  user           User?        @relation("UserMessages", fields: [userId], references: [id], onDelete: SetNull)
  conversation   Conversation @relation("ConversationMessages", fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model DailyLog {
  id            String   @id @default(cuid())
  userId        String
  checkIns      Int      @default(0)
  messagesCount Int      @default(0)
  logDate       DateTime @default(now())
  emotionalState String?
  note          String?
  mood          String?
  challengeStatus String?
  momentum      Int?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, logDate])
  @@index([emotionalState, createdAt])
}

model Insight {
  id        String   @id @default(cuid())
  type      String   // retention, behavior, risk, clarity, engagement
  title     String
  content   String
  action    String
  confidence String  @default("medium") // low, medium, high
  priority  String   @default("medium") // low, medium, high
  createdAt DateTime @default(now())
}

model UserState {
  id               String    @id @default(cuid())
  userId           String    @unique
  state            String    // "neutral" | "duda" | "bloqueo" | "ansiedad" | "claridad"
  transformationPhase String @default("bloqueo")
  mood             String?
  primaryEmotion   String    @default("calma")
  dominantPattern  String    @default("evita_decidir")
  focusArea        String    @default("propósito")
  energyLevel      String    @default("medio")
  riskLevel        String    @default("low")
  progressTrend    String    @default("igual")
  crisisActive     Boolean   @default(false)
  crisisActivatedAt DateTime?
  crisisActiveUntil DateTime?
  updatedAt        DateTime  @updatedAt

  @@index([state, updatedAt])
  @@index([transformationPhase, updatedAt])
  @@index([primaryEmotion, dominantPattern, updatedAt])
  @@index([crisisActive, crisisActiveUntil])
}

model DailyCheckin {
  id        String   @id @default(cuid())
  userId    String
  response  String
  mood      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model DecisionLog {
  id        String   @id @default(cuid())
  metric    String
  value     Float
  decision  String
  createdAt DateTime @default(now())

  @@index([metric, createdAt])
}

model Event {
  id        String   @id @default(cuid())
  userId    String
  type      String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model CrisisEvent {
  id        String   @id @default(cuid())
  userId    String
  level     String
  message   String
  response  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([level, createdAt])
  @@index([userId, createdAt])
}

model Goal {
  id        String   @id @default(cuid())
  userId    String
  title     String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  actions   Action[]

  @@index([userId, status, createdAt])
}

model Action {
  id          String   @id @default(cuid())
  goalId      String
  description String
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  goal        Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  avoidanceEvents AvoidanceEvent[]

  @@index([goalId, createdAt])
}

model AvoidanceEvent {
  id        String   @id @default(cuid())
  userId    String
  actionId  String
  type      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    Action   @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([actionId, createdAt])
  @@index([actionId, type, createdAt])
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String
  status    String
  plan      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, plan, createdAt])
}

model Profile {
  id               String       @id @default(cuid())
  code             String       @unique
  type             String
  title            String
  description      String
  operationalFocus String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  userProfiles     UserProfile[]
  challenges       Challenge[]

  @@index([type, updatedAt])
}

model UserProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  profileId       String
  clarityScore    Int
  autoestimaScore Int
  energiaScore    Int
  disciplinaScore Int
  socialScore     Int
  totalScore      Int
  rawAnswers      Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile         Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, updatedAt])
  @@index([totalScore, updatedAt])
}

model Challenge {
  id               String          @id @default(cuid())
  slug             String          @unique
  profileId        String?
  type             String
  title            String
  description      String
  difficulty       Int
  durationDays     Int
  estimatedMinutes Int
  instructions     String
  successMetric    String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  profile          Profile?        @relation(fields: [profileId], references: [id], onDelete: SetNull)
  userChallenges   UserChallenge[]

  @@index([type, difficulty])
  @@index([profileId, difficulty])
}

model UserChallenge {
  id             String    @id @default(cuid())
  userId         String
  challengeId    String
  status         String    @default("active")
  startedAt      DateTime  @default(now())
  endsAt         DateTime?
  completedDays  Int       @default(0)
  totalDays      Int
  progress       Int       @default(0)
  lastCheckInAt  DateTime?
  validationNote String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge      Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([userId, status, startedAt])
  @@index([challengeId, status])
}

model FutureMessage {
  id          String    @id @default(cuid())
  userId      String
  title       String
  content     String
  unlockAt    DateTime
  deliveredAt DateTime?
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, unlockAt])
  @@index([status, unlockAt])
}

model Streak {
  id              String    @id @default(cuid())
  userId          String    @unique
  currentDays     Int       @default(0)
  bestDays        Int       @default(0)
  lastCheckInDate DateTime?
  status          String    @default("inactive")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
}
